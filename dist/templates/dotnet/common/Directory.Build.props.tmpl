<Project>
  <!-- Build settings shared by every project in this repository.
       Project-specific settings belong in each .csproj. -->
  <PropertyGroup>
    <!-- Single source of truth for the app version. Do not define <Version>
         anywhere else; Installer.ps1 reads this value and injects it into the
         Inno Setup script, and checks CHANGELOG.md (if present) for an entry. -->
    <Version>{{APP_VERSION}}</Version>

    <!-- Keep AssemblyInformationalVersion equal to <Version>: the SDK otherwise
         appends "+<git sha>", and the displayed version must stay "AppName X.Y.Z"
         (see docs/rules/standard.md, Version Display). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Static analysis: built-in Roslyn analyzers + .editorconfig style rules -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Warnings are build errors. Never turn this off; relax individual
         diagnostics at the narrowest scope with a reason
         (see docs/rules/dotnet.md, ANALYZERS). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- VSTHRD analyzers enforce the async rules mechanically (e.g. VSTHRD002:
         no .Result/.Wait() blocking on async code). See docs/rules/dotnet.md,
         ASYNC. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Self-extracting publish is prohibited: it unpacks native libraries into a
       per-build directory under the temp folder that nothing ever deletes. The
       published layout must follow from the dependencies instead
       (see docs/rules/dotnet.md, NATIVEDEP). -->
  <Target Name="ForbidSelfExtractingPublish"
          BeforeTargets="PrepareForPublish"
          Condition="'$(IncludeNativeLibrariesForSelfExtract)' == 'true'">
    <Error Text="IncludeNativeLibrariesForSelfExtract is enabled. Publishing would unpack native libraries into the temp folder on every new build. Remove the property and publish the native libraries beside the executable (see docs/rules/dotnet.md, NATIVEDEP)." />
  </Target>
</Project>
