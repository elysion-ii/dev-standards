<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>{{TFM}}</TargetFramework>
    <RootNamespace>{{APP_NAME}}</RootNamespace>
    <UseWPF>true</UseWPF>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project reaches internal code through this grant; no type is made
         public for a test (docs/rules/dotnet.md, VISIBILITY) -->
    <InternalsVisibleTo Include="{{APP_NAME}}.Tests" />
  </ItemGroup>

</Project>
