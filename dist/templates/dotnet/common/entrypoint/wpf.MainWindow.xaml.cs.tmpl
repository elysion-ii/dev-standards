using System.Reflection;
using System.Windows;

namespace {{APP_NAME}};

internal sealed partial class MainWindow : Window
{
    public MainWindow()
    {
        InitializeComponent();

        // The name and version in the title bar, in the repository's one notation (docs/rules/standard.md, Version Display)
        string version = Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
            .InformationalVersion
            ?? throw new InvalidOperationException("Version attribute missing - the displayed version comes from <Version> in Directory.Build.props");
        Title = $"{{APP_NAME}} {version}";
    }
}
