using System.Reflection;
using System.Runtime.InteropServices;

namespace {{APP_NAME}};

internal static partial class Program
{
    [LibraryImport("user32.dll", EntryPoint = "MessageBoxW", StringMarshalling = StringMarshalling.Utf16)]
    private static partial int MessageBox(IntPtr hWnd, string lpText, string lpCaption, uint uType);

    [STAThread]
    private static int Main()
    {
        // "AppName X.Y.Z" in the window caption (docs/rules/standard.md, Version Display)
        var version = Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
            .InformationalVersion ?? "0.0.0";
        MessageBox(IntPtr.Zero, "Hello from {{APP_NAME}}", $"{{APP_NAME}} {version}", 0);
        return 0;
    }
}
