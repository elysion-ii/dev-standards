using System.Reflection;

namespace {{APP_NAME}};

internal static class Program
{
    private const string AppName = "{{APP_NAME}}";
    private const int ExitCodeUsageError = 2;

    private static int Main(string[] args)
    {
        // --version/-V is mandatory; --help/-h is seeded alongside it (docs/rules/cli.md, RESERVED).
        // "--" ends option parsing: everything after it is arguments (docs/rules/cli.md, OPTIONS)
        if (args.Length > 0 && args[0].StartsWith('-') && args[0] != "--")
        {
            switch (args[0])
            {
                case "--help" or "-h":
                    PrintHelp();
                    return 0;
                case "--version" or "-V":
                    Console.WriteLine($"{AppName} {GetVersion()}");
                    return 0;
                default:
                    Console.Error.WriteLine($"{AppName}: unknown option '{args[0]}'");
                    Console.Error.WriteLine($"Try '{AppName} --help' for more information.");
                    return ExitCodeUsageError;
            }
        }

        Console.WriteLine($"Hello from {AppName}");
        return 0;
    }

    private static string GetVersion() =>
        // Equals <Version> in Directory.Build.props (docs/rules/dotnet.md, VERSION)
        Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
            .InformationalVersion
        ?? throw new InvalidOperationException("Version attribute missing - the displayed version comes from <Version> in Directory.Build.props");

    private static void PrintHelp()
    {
        Console.WriteLine($"{AppName} - console application");
        Console.WriteLine();
        Console.WriteLine($"Usage: {AppName} [options]");
        Console.WriteLine();
        Console.WriteLine("Options:");
        Console.WriteLine("  -h, --help     Print help and exit");
        Console.WriteLine("  -V, --version  Print the version and exit");
    }
}
